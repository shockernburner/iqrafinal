modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
RESEND_FROM_WELCOME_EMAIL = "welcome@iqra.live"
RESEND_FROM_DONATION_EMAIL = "thanks@iqra.live"
RESEND_FROM_PASSWORD_RESET = "Password Reset <reset-password@iqra.live>"
